#include <stdio.h>

// Recursive function to calculate the Nth term
int find_nth_term(int n, int a, int b, int c) {
    // Base cases
    if (n == 1) return a;
    if (n == 2) return b;
    if (n == 3) return c;

    // Recursive case
    return find_nth_term(n - 1, a, b, c) 
         + find_nth_term(n - 2, a, b, c) 
         + find_nth_term(n - 3, a, b, c);
}

int main() {
    int n, a, b, c;

    // Read inputs in HackerRank format
    if (scanf("%d %d %d %d", &n, &a, &b, &c) != 4) {
        printf("Invalid input\n");
        return 1;
    }

    // Output the Nth term
    printf("%d\n", find_nth_term(n, a, b, c));

    return 0;
}
