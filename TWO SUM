from typing import List

def two_sum(nums: List[int], target: int) -> List[int]:
    """
    Returns indices of the two numbers in nums that add up to target.
    Assumes exactly one valid solution exists.
    """
    seen = {}  # Dictionary to store number -> index mapping
    
    for i, num in enumerate(nums):
        complement = target - num
        if complement in seen:
            return [seen[complement], i]  # Found the pair
        seen[num] = i  # Store the index of the current number
    
    # If no solution found (should not happen as per problem statement)
    raise ValueError("No two sum solution exists")

# Example usage
if __name__ == "__main__":
    try:
        print(two_sum([2, 7, 11, 15], 9))   # Output: [0, 1]
        print(two_sum([3, 2, 4], 6))        # Output: [1, 2]
        print(two_sum([3, 3], 6))           # Output: [0, 1]
    except ValueError as e:
        print(e)
