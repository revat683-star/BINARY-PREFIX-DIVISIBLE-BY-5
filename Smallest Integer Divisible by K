class Solution:
    def smallestRepunitDivByK(self, k):
        # If k is divisible by 2 or 5, no repunit can be divisible by k
        if k % 2 == 0 or k % 5 == 0:
            return -1
        
        remainder = 0
        length = 1
        
        while True:
            # Track only the remainder to avoid huge numbers
            remainder = (remainder * 10 + 1) % k
            
            if remainder == 0:
                return length
            
            length += 1
            
            # If we've tried k possibilities, no solution exists
            if length > k:
                return -1
