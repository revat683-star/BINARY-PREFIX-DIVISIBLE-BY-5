#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

// Function to calculate the sum of marks based on gender
int marks_summation(int* marks, int number_of_students, char gender) {
    int sum = 0;

    // If gender is 'b', sum marks at even indices (0, 2, 4, ...)
    // If gender is 'g', sum marks at odd indices (1, 3, 5, ...)
    int start_index = (gender == 'g') ? 1 : 0;

    for (int i = start_index; i < number_of_students; i += 2) {
        sum += marks[i];
    }

    return sum;
}

int main() {
    int number_of_students;
    if (scanf("%d", &number_of_students) != 1 || number_of_students <= 0) {
        printf("Invalid number of students.\n");
        return 1;
    }

    int *marks = malloc(number_of_students * sizeof(int));
    if (marks == NULL) {
        printf("Memory allocation failed.\n");
        return 1;
    }

    // Read marks
    for (int i = 0; i < number_of_students; i++) {
        if (scanf("%d", &marks[i]) != 1) {
            printf("Invalid mark input.\n");
            free(marks);
            return 1;
        }
    }

    char gender;
    scanf(" %c", &gender); // Space before %c to skip newline

    // Calculate and print result
    int result = marks_summation(marks, number_of_students, gender);
    printf("%d\n", result);

    free(marks);
    return 0;
}
